# Shopify Admin API (private/custom app with only read_content + write_content)
SHOPIFY_SHOP=caebikesdirect.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional free-tier LLM fallbacks (leave blank to use local Ollama only)
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_AI_API_KEY=

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b   # change to whatever runs well on your hardware
